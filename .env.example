UNICHAIN_SEPOLIA_RPC_URL=https://sepolia.unichain.org
ETHERSCAN_API_KEY=YOUR_UNISCAN_OR_ETHERSCAN_API_KEY_HERE

# Circle testnet USDC on Unichain Sepolia.
UNICHAIN_SEPOLIA_USDC=0x31d0220469e10c4E71834a79b1f276d740d3768F

# Uniswap v4 periphery StateView on Unichain Sepolia.
UNICHAIN_SEPOLIA_STATE_VIEW=0xc199F1072a74D4e905ABa1A84d9a45E2546B6222

